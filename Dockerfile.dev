# Local development image only.
# Production is built & hosted by Vercel — it ignores this file.
FROM node:22-alpine

WORKDIR /app

# Install dependencies first so this layer is cached unless package files change.
COPY package.json package-lock.json* ./
RUN npm install

# App source is bind-mounted at runtime (see docker-compose.yml),
# so we don't COPY it here — that keeps rebuilds fast.

EXPOSE 3000

CMD ["npm", "run", "dev"]
